{
  "info": {
    "name": "CollabDocs API",
    "description": "Run in order. Register a second user first (edit the Register body, e.g. username bob) so List users can pick them up as member_user_id. Authenticated requests use HTTP Basic auth with {{username}} / {{password}} (alice by default). Switch the username/password variables to act as another user.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "username",
      "value": "alice"
    },
    {
      "key": "password",
      "value": "password123"
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "member_user_id",
      "value": ""
    },
    {
      "key": "workspace_id",
      "value": ""
    },
    {
      "key": "document_id",
      "value": ""
    },
    {
      "key": "comment_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Register user (alice)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('user_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const others = pm.response.json().filter(u => u.id !== pm.collectionVariables.get('user_id'));",
                  "if (others.length) { pm.collectionVariables.set('member_user_id', others[0].id); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Workspaces",
      "item": [
        {
          "name": "Create workspace (atomic: workspace + admin member + audit log)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/workspaces/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "workspaces"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Engineering\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('workspace_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List workspaces",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/workspaces/?name=eng&is_active=true&created_after=2020-01-01",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "workspaces"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "eng"
                },
                {
                  "key": "is_active",
                  "value": "true"
                },
                {
                  "key": "created_after",
                  "value": "2020-01-01"
                }
              ]
            }
          }
        },
        {
          "name": "Get workspace",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/workspaces/{{workspace_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "workspaces",
                "{{workspace_id}}"
              ]
            }
          }
        },
        {
          "name": "Add member (409 if already a member)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/workspaces/{{workspace_id}}/members/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "workspaces",
                "{{workspace_id}}",
                "members"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": \"{{member_user_id}}\",\n  \"role\": \"editor\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Workspace stats (aggregation)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/workspaces/{{workspace_id}}/stats/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "workspaces",
                "{{workspace_id}}",
                "stats"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Create document (atomic: document + version 1 + audit log)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/documents/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "documents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workspace\": \"{{workspace_id}}\",\n  \"title\": \"Design Spec\",\n  \"content\": \"First draft\",\n  \"status\": \"draft\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('document_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List documents (Q search + filters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/documents/?q=spec&status__in=draft,published&workspace={{workspace_id}}&created_after=2020-01-01",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "documents"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "spec"
                },
                {
                  "key": "status__in",
                  "value": "draft,published"
                },
                {
                  "key": "workspace",
                  "value": "{{workspace_id}}"
                },
                {
                  "key": "created_after",
                  "value": "2020-01-01"
                }
              ]
            }
          }
        },
        {
          "name": "Get document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "documents",
                "{{document_id}}"
              ]
            }
          }
        },
        {
          "name": "Update document (new version + audit log via signal)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "documents",
                "{{document_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workspace\": \"{{workspace_id}}\",\n  \"title\": \"Design Spec\",\n  \"content\": \"Second draft\",\n  \"status\": \"published\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List document versions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}/versions/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "documents",
                "{{document_id}}",
                "versions"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Create comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/comments/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "comments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document\": \"{{document_id}}\",\n  \"content\": \"Looks good to me\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('comment_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List comments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/comments/?document={{document_id}}&top_level=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "comments"
              ],
              "query": [
                {
                  "key": "document",
                  "value": "{{document_id}}"
                },
                {
                  "key": "top_level",
                  "value": "true"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Tags",
      "item": [
        {
          "name": "Add tag to document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}/tags/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "documents",
                "{{document_id}}",
                "tags"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"python\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List tags",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tags/?name=py",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tags"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "py"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Audit Logs",
      "item": [
        {
          "name": "List audit logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/audit-logs/?model_name=Document&action__in=created,updated",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "audit-logs"
              ],
              "query": [
                {
                  "key": "model_name",
                  "value": "Document"
                },
                {
                  "key": "action__in",
                  "value": "created,updated"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}